* Measure LELO_ONESHOT_VC
.control

load {cicname}.raw

echo "MEAS_START"

MEAS TRAN tdiffmin TRIG v(OUT) VAL=0.5 RISE=1 TARG v(OUT) VAL=0.5 FALL=1
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=2 TARG v(OUT) VAL=0.5 FALL=2
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=3 TARG v(OUT) VAL=0.5 FALL=3
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=4 TARG v(OUT) VAL=0.5 FALL=4
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=5 TARG v(OUT) VAL=0.5 FALL=5
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=6 TARG v(OUT) VAL=0.5 FALL=6
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=7 TARG v(OUT) VAL=0.5 FALL=7
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=8 TARG v(OUT) VAL=0.5 FALL=8
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=9 TARG v(OUT) VAL=0.5 FALL=9
MEAS TRAN tdiff TRIG v(OUT) VAL=0.5 RISE=10 TARG v(OUT) VAL=0.5 FALL=10
MEAS TRAN tdiffmax TRIG v(OUT) VAL=0.5 RISE=11 TARG v(OUT) VAL=0.5 FALL=11


echo "MEAS_END"
.endc

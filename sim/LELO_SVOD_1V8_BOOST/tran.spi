*TB_SUN_TR_SKY130NM/TB_NCM
*----------------------------------------------------------------
* Include
*----------------------------------------------------------------
#ifdef Lay
.include ../../../work/lpe/LELO_SVOD_1V8_BOOST_lpe.spi
#else
.include ../../../work/xsch/LELO_SVOD_1V8_BOOST.spice
#endif
.include ../../../design/1812PS.lib
.include ../../../design/XGL6030.lib
*-----------------------------------------------------------------
* OPTIONS
*-----------------------------------------------------------------
.option TNOM=27 GMIN=1e-15 reltol=1e-5

*-----------------------------------------------------------------
* PARAMETERS
*-----------------------------------------------------------------
.param TRF = 10p
+ sky130_fd_pr__pfet_01v8__ajunction_mult = 9.9626e-1
+ sky130_fd_pr__pfet_01v8__pjunction_mult = 1.0009e+0

.param Rout = (1.8*1.8*4*5)/(TEG**2)
*-----------------------------------------------------------------
* FORCE
*-----------------------------------------------------------------
VDD      VDD  0 dc {TEG}
R1       OUT1    0 100k
R2       OUT2   0 {Rout}
*-----------------------------------------------------------------
* DUT
*-----------------------------------------------------------------
.include ../xdut.spi

*----------------------------------------------------------------
* PROBE
*----------------------------------------------------------------
.PROBE p(R1)
.PROBE p(R2)

.save i(v.xdut.v1) i(v.xdut.v2)
.save @m.xdut.x1.xm3.msky130_fd_pr__nfet_01v8_lvt[id]
.save @m.xdut.x1.xm5.msky130_fd_pr__nfet_01v8_lvt[id]
.save v(xdut.TEG)
.save v(xdut.VOUT_0V8)
.save v(xdut.VOUT_1V8)
.save v(xdut.x1.VX)
.save v(xdut.x1.HSS1_1V8)

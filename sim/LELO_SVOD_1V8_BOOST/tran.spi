.save v(xdut.x1.x6.VOUT_SAMPL)
.save v(xdut.x1.x5.bias_ref)
.save v(xdut.x1.x5.vgm2)
.save v(vss)
.save v(vdd)
.save v(xdut.vdd_1v8)
.save v(xdut.vdd_0v8)


 

*----------------------------------------------------------------
* NGSPICE control
*----------------------------------------------------------------
.ic v(xdut.x1.x5.bias_ref)=0.32
.ic v(xdut.x1.x5.vgm2)=0.24
.ic v(xdut.x1.x5.net12)=0.11

.save v(xdut.x1.CLK)
.save v(xdut.osc)
.save v(xdut.EN_START)
.save v(xdut.x1.x8.VREF)
.save v(xdut.x1.x8.VMEAS_0V8)
.save v(xdut.x1.x8.VMEAS_1V8)
.save v(xdut.x1.x8.1V8_L)
.save v(xdut.x1.x6.VC)
.save v(xdut.x1.x6.NHSS2_1v8)
.save v(xdut.x1.x6.SN)
.save v(xdut.x1.x6.SP)
.save v(xdut.x1.x6.net2)
.save v(xdut.x1.x6.x3.net2)
.save v(xdut.x1.x6.x3.net1)
.save v(xdut.x1.x6.x4.net2)
.save v(xdut.x1.x6.x4.net3)
.save v(xdut.x1.x6.UP)
.save v(xdut.x1.x6.DN)
.save v(xdut.x1.x6.net6)

* Measure LELO_BOOST_STEADY_STATE
.control

load {cicname}.raw

echo "MEAS_START"
Meas tran I_0V8 AVG i(VDD1) from = 3000u
Meas tran I_1V8 AVG i(VDD2) from = 3000u 
Meas tran VTEG   AVG v(VTEG)

let power=v(xdut.teg)*i(VTEG)
MEAS tran PIN AVG power from = 3000u

Meas tran P_AVG2 AVG r2:power from =3000u
let P2 = P_AVG2 + I_0V8*0.8 + I_1V8*1.8
print P2

let Eff =(P2*4*5)/(VTEG*VTEG)
print Eff

echo "MEAS_END"
.endc

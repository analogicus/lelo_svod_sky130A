* Measure LELO_SVOD_RELOSC
.control

load {cicname}.raw

echo "MEAS_START"
MEAS TRAN T TRIG v(xdut.phase1) VAL=0.1 FALL=15 TARG v(xdut.phase1) VAL=0.1 FALL=16
MEAS TRAN td TRIG v(xdut.phase1) VAL=0.1 FALL=15 TARG v(xdut.phase1) VAL=0.1 RISE=15
MEAS TRAN I AVG i(VDD) from =-1u
MEAS TRAN Iref AVG i(@b.xdut.xr3.brpwres[i])


let f = 1/T
print f

let D = td/T
print D
echo "MEAS_END"
.endc

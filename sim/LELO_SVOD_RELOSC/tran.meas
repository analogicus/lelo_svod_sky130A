* Measure LELO_SVOD_RELOSC
.control

load {cicname}.raw

echo "MEAS_START"
MEAS TRAN T TRIG v(xdut.phase1) VAL=0.5 FALL=6 TARG v(xdut.phase1) VAL=0.5 FALL=7
MEAS TRAN td TRIG v(xdut.phase1) VAL=0.5 FALL=6 TARG v(xdut.phase1) VAL=0.5 RISE=7


let f = 1/T
print f

let D = td/T
print D
echo "MEAS_END"
.endc

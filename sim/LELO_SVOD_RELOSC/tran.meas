* Measure LELO_SVOD_RELOSC
.control

load {cicname}.raw

echo "MEAS_START"
MEAS TRAN T TRIG v(OSC) VAL=0.4 FALL=48 TARG v(OSC) VAL=0.4 FALL=49
MEAS TRAN td TRIG v(OSC) VAL=0.4 RISE=LAST TARG v(OSC) VAL=0.4 FALL=LAST
MEAS TRAN I AVG i(VDD) from =-100u
MEAS TRAN Iref AVG i(@b.xdut.xr1.brpwres[i]) from =1m


let f = 1/T
print f

let D = td/T
print D
let R = (2*18u*f)/(D^2)
print R
echo "MEAS_END"
.endc

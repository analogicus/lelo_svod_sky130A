* Measure LELO_SVOD_RELOSC
.control

load {cicname}.raw

echo "MEAS_START"
MEAS TRAN T TRIG v(xdut.OUT) VAL=0.4 FALL=25 TARG v(xdut.OUT) VAL=0.4 FALL=26
MEAS TRAN td TRIG v(xdut.OUT) VAL=0.4 FALL=25 TARG v(xdut.OUT) VAL=0.4 RISE=25
MEAS TRAN I AVG i(VDD) from =-1u
MEAS TRAN Iref AVG i(@b.xdut.xr3.brpwres[i])


let f = 1/T
print f

let D = td/T
print D
echo "MEAS_END"
.endc

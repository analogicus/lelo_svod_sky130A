* Measure LELO_SVOD_RELOSC
.control

load {cicname}.raw

echo "MEAS_START"
MEAS TRAN T TRIG v(OSC) VAL=0.4 FALL=196 TARG v(OSC) VAL=0.4 FALL=197
MEAS TRAN td TRIG v(OSC) VAL=0.4 RISE=LAST TARG v(OSC) VAL=0.4 FALL=LAST
MEAS TRAN I AVG i(VDD) from =-100u
MEAS TRAN Iref AVG i(@b.xdut.xr3.brpwres[i])


meas tran tc WHEN v(xdut.net1)=v(xdut.net10) RISE=LAST
meas tran ts WHEN v(osc)=0.1 FALL=LAST
meas tran te WHEN v(osc)=0.4 RISE=LAST


let trc = tc -ts
print trc
let tcmp = te - tc
print tcmp



let f = 1/T
print f

let D = td/T
print D
let R = (2*18u*f)/(D^2)
print R
echo "MEAS_END"
.endc

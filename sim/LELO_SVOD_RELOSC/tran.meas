* Measure LELO_SVOD_RELOSC
.control

load {cicname}.raw

echo "MEAS_START"
MEAS TRAN T TRIG v(OSC) VAL=0.4 FALL=45 TARG v(OSC) VAL=0.4 FALL=46
MEAS TRAN td TRIG v(OSC) VAL=0.4 RISE=45 TARG v(OSC) VAL=0.4 FALL=45
MEAS TRAN I AVG i(VDD) from =-1u
MEAS TRAN Iref AVG i(@b.xdut.xr3.brpwres[i])


let f = 1/T
print f

let D = td/T
print D
echo "MEAS_END"
.endc

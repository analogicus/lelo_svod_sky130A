* Measure LELO_BOOST_STEADY_STATE
.control

load {cicname}.raw

echo "MEAS_START"
Meas tran I_LOGIC AVG i(v.xdut.V1) from = 100u
Meas tran I_RO AVG i(v.xdut.V4) from = 100u
Meas tran I_LSS AVG i(v.xdut.V3) from = 100u
Meas tran I_HSS AVG i(v.xdut.V6) from = 100u
Meas tran I_DEL AVG i(v.xdut.V5) from = 100u
Meas tran I_CMP AVG i(v.xdut.V7) from = 100u
Meas tran I_CP AVG i(v.xdut.V8) from = 100u
let I_CNTRL = I_CMP +I_DEL + I_HSS + I_LOGIC + I_LSS + I_RO +I_CP
print I_CNTRL
Meas tran VOUT AVG v(xdut.vddc) from = 100u
Meas tran IOUT AVG i(@r.xdut.r2[i]) from = 100u
Meas tran Iin AVG i(@r.xdut.r1[i]) from = 100u
Meas tran VIN AVG v(xdut.TEG) from = 100u
let Pin = VIN*Iin

Meas tran P_AVG AVG r1:power from =100u

let P = P_AVG + I_CNTRL*0.8
print P

print eff


wrdata ffTh_data.txt (xdut.vddc) (xdut.vhss1) (xdut.v1); Save V(out) and I(V1) to output.txt

echo "MEAS_END"
.endc

* Measure LELO_BOOST_STEADY_STATE
.control

load {cicname}.raw

echo "MEAS_START"
Meas tran I_0V8 AVG i(vdd1) from = 1000u
Meas tran I_1V8 AVG i(vdd2) from = 1000u
Meas tran TEG   AVG v(VTEG)

let power=v(xdut.teg)*i(VTEG)
MEAS tran PIN AVG power from = 1000u

Meas tran P_AVG1 AVG r1:power from =1000u
let P1 = P_AVG1 + I_0V8*0.8 + I_1V8*1.8
print P1

let Eff =(P1*4*5)/(TEG*TEG)
print Eff


echo "MEAS_END"
.endc

* Measure LELO_BOOST_STEADY_STATE
.control

load {cicname}.raw

echo "MEAS_START"
Meas tran I_0V8 AVG i(v.xdut.V1) from = 200u
Meas tran I_1V8 AVG i(v.xdut.V2) from = 200u

Meas tran P_AVG1 AVG r1:power from =200u

let P1 = P_AVG1 + I_0V8*0.8 + I_1V8*1.8
print P1

Meas tran P_AVG2 AVG r2:power from =200u
let P2 = P_AVG2 + I_0V8*0.8 + I_1V8*1.8
print P2


wrdata ffTh_data.txt (xdut.vddc) (xdut.vhss1) (xdut.v1); Save V(out) and I(V1) to output.txt

echo "MEAS_END"
.endc